@inject AdminRegistroViewModel ViewModel

<MudDialog>
    <DialogContent>
        @if (_isLoading)
        {
            <MudProgressLinear Color="Color.Secondary" Indeterminate="true" Class="mb-3" />
        }
        @if (!string.IsNullOrWhiteSpace(ViewModel.ErrorMessage))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-3">@ViewModel.ErrorMessage</MudAlert>
        }
        <RegistroForm ViewModel="ViewModel" ShowClearButton="false" OnSaved="CloseSaved" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text"
                   Color="Color.Default"
                   Disabled="@ViewModel.IsSaving"
                   OnClick="Cancel">
            Cancelar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private bool _isLoading = true;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public int? DenominacionId { get; set; }

    [Parameter]
    public string? DenominacionNombre { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await ViewModel.InitializeAsync(esInterno: false, DenominacionId, DenominacionNombre);
        _isLoading = false;
    }

    private void CloseSaved()
    {
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}
