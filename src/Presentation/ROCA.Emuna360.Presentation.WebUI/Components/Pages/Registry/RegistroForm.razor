@using ROCA.Emuna360.Presentation.WebUI.ViewModels.Registry
@using ROCA.Emuna360.Application.DTOs.Organization
@inject IDialogService DialogService
@inject ISnackbar Snackbar

@if (ViewModel.IsRegistroPublico)
{
    @if (ViewModel.IsLoadingDenominacion)
    {
        <MudProgressLinear Color="Color.Secondary" Indeterminate="true" Class="mb-3" />
    }
    else
    {
        <MudTextField T="string"
                      Label="Denominacion"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Disabled="true"
                      Class="mb-3"
                      Value="@GetDenominacionText()" />
    }
}
<MudGrid Spacing="2">
    <MudItem xs="12">
        @if (ViewModel.IglesiaId > 0)
        {
            <MudTextField T="string"
                          Label="Iglesia"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Disabled="true"
                          Value="@ViewModel.RegistroIglesiaNombre" />
        }
        else
        {
            <div class="registro-iglesia-selector @(ViewModel.RegistroForm.IglesiaId > 0 ? string.Empty : "selector-required")">
                <div class="registro-iglesia-selector-content">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Iglesia *</MudText>
                    <MudText Typo="Typo.body1" Class="mud-typography-fontWeightMedium">
                        @ViewModel.RegistroIglesiaNombre
                    </MudText>
                </div>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Church"
                           Disabled="@ViewModel.IsSaving"
                           OnClick="OpenIglesiaSelectorAsync">
                    Seleccionar
                </MudButton>
            </div>
        }
    </MudItem>
    @if (!ViewModel.IsEditing)
    {
    <MudItem xs="12" sm="12">
        <MudSelect T="string"
                   Label="Crear usuario con"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Required="true"
                   Clearable="true"
                   @bind-Value="ViewModel.CrearUsuarioCon"
                   OnBlur="@(() => ViewModel.TouchField(AdminRegistroViewModel.RegistroFormField.CrearUsuarioCon))"
                   Error="@HasError(ViewModel.GetFieldError(AdminRegistroViewModel.RegistroFormField.CrearUsuarioCon))"
                   ErrorText="@ViewModel.GetFieldError(AdminRegistroViewModel.RegistroFormField.CrearUsuarioCon)">
            <MudSelectItem T="string" Value="@("Documento")">
                Documento
            </MudSelectItem>
            <MudSelectItem T="string" Value="@("Correo")">
                Correo
            </MudSelectItem>
        </MudSelect>
    </MudItem>

    <MudItem xs="12" sm="6">
        <MudSelect T="int?"
                   Label="Rol"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Required="true"
                   Disabled="@ViewModel.IsRolBloqueado"
                   @bind-Value="ViewModel.RolId"
                   OnBlur="@(() => ViewModel.TouchField(AdminRegistroViewModel.RegistroFormField.Rol))"
                   Error="@HasError(ViewModel.GetFieldError(AdminRegistroViewModel.RegistroFormField.Rol))"
                   ErrorText="@ViewModel.GetFieldError(AdminRegistroViewModel.RegistroFormField.Rol)">
            @foreach (var rol in ViewModel.RolOptionsForForm)
            {
                <MudSelectItem T="int?" Value="@((int?)rol.RolId)">@rol.Nombre</MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <MudItem xs="12" sm="6">
        <MudTextField T="string"
                      Label="Contraseña"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Immediate="true"
                      InputType="InputType.Password"
                      Required="true"
                      @bind-Value="ViewModel.Contrasena"
                      OnBlur="@(() => ViewModel.TouchField(AdminRegistroViewModel.RegistroFormField.Contrasena))"
                      Error="@HasError(ViewModel.GetFieldError(AdminRegistroViewModel.RegistroFormField.Contrasena))"
                      ErrorText="@ViewModel.GetFieldError(AdminRegistroViewModel.RegistroFormField.Contrasena)" />
    </MudItem>

    <MudItem xs="12" sm="6">
        <MudTextField T="string"
                      Label="Repetir contraseÃ±a"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Immediate="true"
                      InputType="InputType.Password"
                      Required="true"
                      @bind-Value="ViewModel.ConfirmarContrasena"
                      OnBlur="@(() => ViewModel.TouchField(AdminRegistroViewModel.RegistroFormField.ConfirmarContrasena))"
                      Error="@HasError(ViewModel.GetFieldError(AdminRegistroViewModel.RegistroFormField.ConfirmarContrasena))"
                      ErrorText="@ViewModel.GetFieldError(AdminRegistroViewModel.RegistroFormField.ConfirmarContrasena)" />
    </MudItem>

    }

    <MudItem xs="12" sm="6">
        <MudTextField T="string"
                      Label="Nombres"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Immediate="true"
                      Required="true"
                      @bind-Value="ViewModel.RegistroForm.Nombres"
                      OnBlur="@(() => ViewModel.TouchField(AdminRegistroViewModel.RegistroFormField.Nombres))"
                      Error="@HasError(ViewModel.GetFieldError(AdminRegistroViewModel.RegistroFormField.Nombres))"
                      ErrorText="@ViewModel.GetFieldError(AdminRegistroViewModel.RegistroFormField.Nombres)" />
    </MudItem>

    <MudItem xs="12" sm="6">
        <MudTextField T="string"
                      Label="Apellidos"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Immediate="true"
                      Required="true"
                      @bind-Value="ViewModel.RegistroForm.Apellidos"
                      OnBlur="@(() => ViewModel.TouchField(AdminRegistroViewModel.RegistroFormField.Apellidos))"
                      Error="@HasError(ViewModel.GetFieldError(AdminRegistroViewModel.RegistroFormField.Apellidos))"
                      ErrorText="@ViewModel.GetFieldError(AdminRegistroViewModel.RegistroFormField.Apellidos)" />
    </MudItem>

    <MudItem xs="12" sm="6">
        <MudSelect T="int?"
                   Label="Tipo documento"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Required="true"
                   @bind-Value="ViewModel.RegistroForm.ParametroIdTipoDocumento"
                   OnBlur="@(() => ViewModel.TouchField(AdminRegistroViewModel.RegistroFormField.TipoDocumento))"
                   Error="@HasError(ViewModel.GetFieldError(AdminRegistroViewModel.RegistroFormField.TipoDocumento))"
                   ErrorText="@ViewModel.GetFieldError(AdminRegistroViewModel.RegistroFormField.TipoDocumento)">
            @foreach (var tipo in ViewModel.TipoDocumentoOptions)
            {
                <MudSelectItem T="int?" Value="@((int?)tipo.ParametroId)">@tipo.Descripcion</MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <MudItem xs="12" sm="6">
        <MudTextField T="string"
                      Label="Documento"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Immediate="true"
                      Required="true"
                      @bind-Value="ViewModel.RegistroForm.Documento"
                      OnBlur="@(() => ViewModel.TouchField(AdminRegistroViewModel.RegistroFormField.Documento))"
                      Error="@HasError(ViewModel.GetFieldError(AdminRegistroViewModel.RegistroFormField.Documento))"
                      ErrorText="@ViewModel.GetFieldError(AdminRegistroViewModel.RegistroFormField.Documento)" />
    </MudItem>

    <MudItem xs="12" sm="6">
        <MudSelect T="int?"
                   Label="Sexo"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Required="true"
                   @bind-Value="ViewModel.RegistroForm.ParametroIdSexo"
                   OnBlur="@(() => ViewModel.TouchField(AdminRegistroViewModel.RegistroFormField.Sexo))"
                   Error="@HasError(ViewModel.GetFieldError(AdminRegistroViewModel.RegistroFormField.Sexo))"
                   ErrorText="@ViewModel.GetFieldError(AdminRegistroViewModel.RegistroFormField.Sexo)">
            @foreach (var sexo in ViewModel.SexoOptions)
            {
                <MudSelectItem T="int?" Value="@((int?)sexo.ParametroId)">@sexo.Descripcion</MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <MudItem xs="12" sm="6">
        <MudTextField T="string"
                      Label="Correo"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Immediate="true"
                      @bind-Value="ViewModel.RegistroForm.Correo"
                      OnBlur="@(() => ViewModel.TouchField(AdminRegistroViewModel.RegistroFormField.Correo))"
                      Error="@HasError(ViewModel.GetFieldError(AdminRegistroViewModel.RegistroFormField.Correo))"
                      ErrorText="@ViewModel.GetFieldError(AdminRegistroViewModel.RegistroFormField.Correo)" />
    </MudItem>

    <MudItem xs="12" sm="6">
        <MudTextField T="string"
                      Label="Telefono"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Immediate="true"
                      @bind-Value="ViewModel.RegistroForm.Telefono" />
    </MudItem>

    <MudItem xs="12" sm="6">
        <MudSelect T="int?"
                   Label="Pais"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Value="@ViewModel.RegistroForm.PaisId"
                   ValueChanged="ViewModel.ChangePaisAsync">
            @foreach (var pais in ViewModel.Paises)
            {
                <MudSelectItem T="int?" Value="@((int?)pais.PaisId)">@pais.PaisNombre</MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <MudItem xs="12" sm="6">
        <MudSelect T="int?"
                   Label="Departamento"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Disabled="@(!ViewModel.Departamentos.Any())"
                   Value="@ViewModel.RegistroForm.DepartamentoId"
                   ValueChanged="ViewModel.ChangeDepartamentoAsync">
            @foreach (var departamento in ViewModel.Departamentos)
            {
                <MudSelectItem T="int?" Value="@((int?)departamento.DepartamentoId)">@departamento.DepartamentoNombre</MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <MudItem xs="12" sm="6">
        <MudSelect T="int?"
                   Label="Ciudad"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Disabled="@(!ViewModel.Ciudades.Any())"
                   Value="@ViewModel.RegistroForm.CiudadId"
                   ValueChanged="ViewModel.ChangeCiudadAsync">
            @foreach (var ciudad in ViewModel.Ciudades)
            {
                <MudSelectItem T="int?" Value="@((int?)ciudad.CiudadId)">@ciudad.CiudadNombre</MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <MudItem xs="12" sm="6">
        <MudSelect T="int?"
                   Label="Corregimiento"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Disabled="@(!ViewModel.Corregimientos.Any())"
                   Value="@ViewModel.RegistroForm.CorregimientoId"
                   ValueChanged="ViewModel.ChangeCorregimiento">
            @foreach (var corregimiento in ViewModel.Corregimientos)
            {
                <MudSelectItem T="int?" Value="@((int?)corregimiento.CorregimientoId)">@corregimiento.CorregimientoNombre</MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <MudItem xs="12" sm="6">
        <MudSelect T="int?"
                   Label="Interés"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Required="true"
                   @bind-Value="ViewModel.RegistroForm.ParametroIdInteres"
                   OnBlur="@(() => ViewModel.TouchField(AdminRegistroViewModel.RegistroFormField.Interes))"
                   Error="@HasError(ViewModel.GetFieldError(AdminRegistroViewModel.RegistroFormField.Interes))"
                   ErrorText="@ViewModel.GetFieldError(AdminRegistroViewModel.RegistroFormField.Interes)">
            @foreach (var tipo in ViewModel.InteresOptions)
            {
                <MudSelectItem T="int?" Value="@((int?)tipo.ParametroId)">@tipo.Descripcion</MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <MudItem xs="12">
        <MudTextField T="string"
                      Label="Direccion"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Immediate="true"
                      Lines="2"
                      @bind-Value="ViewModel.RegistroForm.Direccion" />
    </MudItem>
</MudGrid>

<div class="registro-form-actions mt-4">
    @if (ShowClearButton)
    {
        <MudButton Variant="Variant.Text"
                   Color="Color.Default"
                   Disabled="@ViewModel.IsSaving"
                   OnClick="ViewModel.StartNewRegistro">
            Limpiar
        </MudButton>
    }
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Save"
               Disabled="@ViewModel.IsSaving"
               OnClick="SaveRegistroAsync">
        @if (ViewModel.IsSaving)
        {
            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
            <MudText Class="ms-2">Guardando...</MudText>
        }
        else
        {
            <MudText>@(ViewModel.IsEditing ? "Actualizar" : "Guardar")</MudText>
        }
    </MudButton>
</div>

<style>
    .registro-form-actions {
        align-items: center;
        display: flex;
        gap: .75rem;
        justify-content: flex-end;
    }

    .registro-iglesia-selector {
        align-items: center;
        border: 1px solid var(--mud-palette-lines-inputs);
        border-radius: var(--mud-default-borderradius);
        display: flex;
        gap: .75rem;
        justify-content: space-between;
        min-height: 56px;
        padding: .55rem .75rem;
    }

    .registro-iglesia-selector.selector-required {
        border-color: var(--mud-palette-warning);
    }

    .registro-iglesia-selector-content {
        min-width: 0;
    }

    @@media (max-width: 600px) {
        .registro-form-actions,
        .registro-iglesia-selector {
            align-items: stretch;
            flex-direction: column;
            justify-content: flex-start;
        }
    }
</style>

@code {
    [Parameter, EditorRequired]
    public AdminRegistroViewModel ViewModel { get; set; } = default!;

    [Parameter]
    public bool ShowClearButton { get; set; } = true;

    [Parameter]
    public EventCallback OnSaved { get; set; }

    [Parameter]
    public EventCallback OnRegistroGuardado { get; set; }

    private static bool HasError(string? error)
    {
        return !string.IsNullOrWhiteSpace(error);
    }


    private string GetDenominacionText()
    {
        return string.IsNullOrWhiteSpace(ViewModel.DenominacionNombre)
            ? $"Denominacion {ViewModel.DenominacionId}"
            : ViewModel.DenominacionNombre;
    }
    private async Task SaveRegistroAsync()
    {
        await ViewModel.SaveRegistroAsync();

        if (ViewModel.LastSaveSucceeded)
        {
            if (OnRegistroGuardado.HasDelegate)
            {
                await OnRegistroGuardado.InvokeAsync();
            }

            await OnSaved.InvokeAsync();
        }
    }

    private async Task OpenIglesiaSelectorAsync()
    {
        if (ViewModel.DenominacionId <= 0)
        {
            Snackbar.Add("No fue posible determinar la denominacion para seleccionar una iglesia.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            [nameof(IglesiaSelectorDialog.DenominacionId)] = ViewModel.DenominacionId,
            [nameof(IglesiaSelectorDialog.SelectedIglesiaId)] = ViewModel.RegistroForm.IglesiaId > 0 ? ViewModel.RegistroForm.IglesiaId : (int?)null
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            FullWidth = true,
            MaxWidth = MaxWidth.Large
        };

        var dialog = await DialogService.ShowAsync<IglesiaSelectorDialog>(
            "Seleccionar iglesia",
            parameters,
            options);

        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not IglesiaDto iglesia)
            return;

        ViewModel.SelectIglesia(iglesia);
    }
}
