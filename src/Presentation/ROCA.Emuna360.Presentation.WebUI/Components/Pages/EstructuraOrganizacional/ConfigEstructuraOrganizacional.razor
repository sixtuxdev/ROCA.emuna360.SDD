@page "/estructura-organizacional/configuracion"
@attribute [Authorize(Roles = "Administrador,Pastor")]
@using ROCA.Emuna360.Application.DTOs.Structure
@using ROCA.Emuna360.Presentation.WebUI.ViewModels.Structure
@inject ConfigEstructuraOrganizacionalViewModel ViewModel

<PageTitle>Estructura Organizacional - ROCA.Emuna360</PageTitle>

<section class="estructura-shell">
    <div class="estructura-header">
        <div>
            <MudText Typo="Typo.h4" Color="Color.Primary" Class="estructura-title">Estructura Organizacional</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">Administre jerarquias organizacionales multinivel</MudText>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(ViewModel.ErrorMessage))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@ViewModel.ErrorMessage</MudAlert>
    }

    <MudPaper Class="pa-4 estructura-container" Elevation="2">
        <MudGrid Spacing="3">
            <MudItem xs="12" md="6">
                <MudCard Class="estructura-card">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Estructuras Organizacionales</MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                Gestione la estructura organizacional del sistema
                            </MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                           Color="Color.Secondary"
                                           Disabled="@ViewModel.IsLoadingTree"
                                           OnClick="ViewModel.LoadEstructurasAsync" />
                        </CardHeaderActions>
                    </MudCardHeader>

                    <MudCardContent Class="pa-0">
                        @if (ViewModel.IsLoadingTree)
                        {
                            <div class="tree-loading">
                                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
                                <MudText Typo="Typo.body2" Class="mud-text-secondary mt-4">
                                    Cargando estructuras organizacionales...
                                </MudText>
                            </div>
                        }
                        else if (ViewModel.HasEstructuras)
                        {
                            <div class="tree-scroll">
                                <MudTreeView T="EstructuraOrganizacionalDto" Dense="true" Hover="true">
                                    @foreach (var estructura in ViewModel.RootEstructuras)
                                    {
                                        @RenderTreeItem(estructura)
                                    }
                                </MudTreeView>
                            </div>
                        }
                        else
                        {
                            <MudPaper Class="empty-state pa-8 ma-4" Elevation="0">
                                <MudIcon Icon="@Icons.Material.Filled.AccountTree"
                                         Size="Size.Large"
                                         Color="Color.Default"
                                         Class="mb-3" />
                                <MudText Typo="Typo.h6" Class="mud-text-secondary mb-2">
                                    No hay estructuras organizacionales registradas
                                </MudText>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary text-center">
                                    Comience agregando una nueva estructura organizacional al sistema
                                </MudText>
                            </MudPaper>
                        }
                    </MudCardContent>

                    <MudCardActions Class="tree-actions">
                        <MudButton Variant="Variant.Outlined"
                                   StartIcon="@Icons.Material.Filled.Refresh"
                                   Disabled="@ViewModel.IsLoadingTree"
                                   OnClick="ViewModel.LoadEstructurasAsync">
                            Recargar
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="ViewModel.StartNewRoot">
                            Nueva raiz
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Secondary"
                                   StartIcon="@Icons.Material.Filled.AccountTree"
                                   Disabled="@(ViewModel.SelectedEstructura is null)"
                                   OnClick="ViewModel.StartNewChild">
                            Crear hijo
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudCard Class="estructura-card">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">@ViewModel.FormTitle</MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                Complete el formulario con los datos de la estructura organizacional
                            </MudText>
                        </CardHeaderContent>
                    </MudCardHeader>

                    <MudCardContent>
                        <MudGrid Spacing="2">
                            @* <MudItem xs="12" Style="display: none;">
                                <MudTextField T="string"
                                              Label="Denominacion ID"
                                              Value="@ViewModel.DenominacionLabel"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              ReadOnly="true"
                                              HelperText="Se obtiene automaticamente del sistema" />
                            </MudItem> *@

                            <MudItem xs="12">
                                <MudTextField T="string"
                                              Label="Descripcion *"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Lines="4"
                                              Required="true"
                                              Immediate="true"
                                              OnBlur="@(() => ViewModel.TouchFormField(ConfigEstructuraOrganizacionalViewModel.EstructuraFormField.Descripcion))"
                                              Error="@HasError(ViewModel.GetFormFieldError(ConfigEstructuraOrganizacionalViewModel.EstructuraFormField.Descripcion))"
                                              ErrorText="@ViewModel.GetFormFieldError(ConfigEstructuraOrganizacionalViewModel.EstructuraFormField.Descripcion)"
                                              @bind-Value="ViewModel.EstructuraForm.Descripcion" />
                            </MudItem>

                            <MudItem xs="12">
                                <MudTextField T="string"
                                              Label="Responsable (Pastor) *"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Required="true"
                                              Immediate="true"
                                              HelperText="Ingrese el nombre del responsable"
                                              OnBlur="@(() => ViewModel.TouchFormField(ConfigEstructuraOrganizacionalViewModel.EstructuraFormField.Responsable))"
                                              Error="@HasError(ViewModel.GetFormFieldError(ConfigEstructuraOrganizacionalViewModel.EstructuraFormField.Responsable))"
                                              ErrorText="@ViewModel.GetFormFieldError(ConfigEstructuraOrganizacionalViewModel.EstructuraFormField.Responsable)"
                                              @bind-Value="ViewModel.EstructuraForm.Responsable" />
                            </MudItem>

                            <MudItem xs="12">
                                <MudAutocomplete T="EstructuraOrganizacionalDto"
                                                 Label="Estructura Padre"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense"
                                                 Clearable="true"
                                                 HelperText="Seleccione una estructura padre desde el arbol o busquela aqui (opcional)"
                                                 ToStringFunc="@(estructura => estructura is null ? string.Empty : estructura.Descripcion)"
                                                 SearchFunc="ViewModel.SearchParentAsync"
                                                 Value="@ViewModel.SelectedPadre"
                                                 ValueChanged="OnParentChanged"
                                                 OnBlur="@(() => ViewModel.TouchFormField(ConfigEstructuraOrganizacionalViewModel.EstructuraFormField.Padre))"
                                                 Error="@HasError(ViewModel.GetFormFieldError(ConfigEstructuraOrganizacionalViewModel.EstructuraFormField.Padre))"
                                                 ErrorText="@ViewModel.GetFormFieldError(ConfigEstructuraOrganizacionalViewModel.EstructuraFormField.Padre)" />
                            </MudItem>

                            @* <MudItem xs="12" sm="6">
                                <MudNumericField T="int"
                                                 Label="Orden"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense"
                                                 Min="1"
                                                 @bind-Value="ViewModel.EstructuraForm.Orden" />
                            </MudItem> *@

                            <MudItem xs="12" sm="6">
                                <MudSwitch T="bool"
                                           Label="Activa"
                                           Color="Color.Primary"
                                           @bind-Value="ViewModel.EstructuraForm.Estado" />
                            </MudItem>
                        </MudGrid>

                        <div class="form-actions mt-4">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Save"
                                       Disabled="@(!ViewModel.CanSave)"
                                       OnClick="ViewModel.SaveAsync">
                                @ViewModel.SaveButtonText
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       Disabled="@ViewModel.IsSaving"
                                       OnClick="ViewModel.StartNewRoot">
                                Nuevo
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Error"
                                       StartIcon="@Icons.Material.Filled.Delete"
                                       Disabled="@(!ViewModel.CanDeleteSelected)"
                                       OnClick="ViewModel.DeleteSelectedAsync">
                                Eliminar
                            </MudButton>
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    </MudPaper>
</section>

<style>
    .estructura-shell {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .estructura-header,
    .tree-actions,
    .form-actions {
        display: flex;
        align-items: center;
        gap: .75rem;
    }

    .estructura-header {
        justify-content: space-between;
    }

    .estructura-title {
        font-weight: 700;
    }

    .estructura-container,
    .estructura-card {
        border: 1px solid var(--mud-palette-divider);
        border-radius: var(--mud-default-borderradius);
    }

    .estructura-card {
        height: 100%;
    }

    .tree-loading,
    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 18rem;
        text-align: center;
    }

    .empty-state {
        background-color: var(--mud-palette-action-disabled-background);
        border-radius: 8px;
    }

    .tree-scroll {
        max-height: 600px;
        overflow-y: auto;
        padding: .5rem 1rem 1rem;
    }

    .tree-node-label {
        min-width: 0;
    }

    .tree-node-meta {
        display: flex;
        align-items: center;
        gap: .5rem;
        flex-wrap: wrap;
        margin-top: .15rem;
    }

    .tree-actions,
    .form-actions {
        flex-wrap: wrap;
    }

    @@media (max-width: 600px) {
        .tree-actions,
        .form-actions {
            align-items: stretch;
            flex-direction: column;
        }
    }
</style>

@code {
    protected override async Task OnInitializedAsync()
    {
        await ViewModel.InitializeAsync();
    }

    private RenderFragment RenderTreeItem(EstructuraOrganizacionalDto estructura) => @<MudTreeViewItem T="EstructuraOrganizacionalDto"
        Value="@estructura"
        Text="@estructura.Descripcion"
        EndText="@(estructura.Estado ? "Activa" : "Inactiva")"
        Icon="@Icons.Material.Filled.AccountTree"
        IconExpanded="@Icons.Material.Filled.FolderOpen"
        IconColor="@(ViewModel.IsSelected(estructura) ? Color.Primary : Color.Secondary)"
        CanExpand="@ViewModel.HasChildren(estructura)"
        Expanded="@ViewModel.IsExpanded(estructura)"
        ExpandedChanged="@((bool expanded) => ViewModel.SetExpanded(estructura, expanded))"
        Selected="@ViewModel.IsSelected(estructura)"
        OnClick="@(() => ViewModel.SelectEstructura(estructura))">
        @foreach (var child in ViewModel.GetChildren(estructura))
        {
            @RenderTreeItem(child)
        }
    </MudTreeViewItem>;

    private void OnParentChanged(EstructuraOrganizacionalDto? estructura)
    {
        ViewModel.SetParent(estructura);
    }

    private static bool HasError(string? error)
    {
        return !string.IsNullOrWhiteSpace(error);
    }
}
