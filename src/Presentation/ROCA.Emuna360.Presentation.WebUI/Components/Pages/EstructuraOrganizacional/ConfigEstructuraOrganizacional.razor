@page "/estructura-organizacional/configuracion"
@attribute [Authorize(Roles = "Administrador,Pastor")]
@using ROCA.Emuna360.Application.DTOs.Structure
@using ROCA.Emuna360.Presentation.WebUI.ViewModels.Structure
@inject ConfigEstructuraOrganizacionalViewModel ViewModel

<PageTitle>Estructura Organizacional - ROCA.Emuna360</PageTitle>

<section class="estructura-shell">
    <div class="estructura-header">
        <div>
            <MudText Typo="Typo.h4" Color="Color.Primary" Class="estructura-title">Estructura Organizacional</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">Administre jerarquias organizacionales multinivel</MudText>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(ViewModel.ErrorMessage))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@ViewModel.ErrorMessage</MudAlert>
    }

    <MudPaper Class="pa-4 estructura-container" Elevation="2">
        <MudGrid Spacing="3">
            <MudItem xs="12" md="6">
                <MudCard Class="estructura-card">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Estructuras Organizacionales</MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                Gestione la estructura organizacional del sistema
                            </MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                           Color="Color.Secondary"
                                           Disabled="@ViewModel.IsLoadingTree"
                                           OnClick="ViewModel.LoadEstructurasAsync" />
                        </CardHeaderActions>
                    </MudCardHeader>

                    <MudCardContent Class="pa-0">
                        @if (ViewModel.IsLoadingTree)
                        {
                            <div class="tree-loading">
                                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
                                <MudText Typo="Typo.body2" Class="mud-text-secondary mt-4">
                                    Cargando estructuras organizacionales...
                                </MudText>
                            </div>
                        }
                        else if (ViewModel.HasEstructuras)
                        {
                            <div class="tree-filter px-4 pb-2">
                                <MudTextField T="string"
                                              Label="Buscar por descripcion o responsable"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Immediate="true"
                                              Clearable="true"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Search"
                                              @bind-Value="_treeSearchText" />
                            </div>
                            <div class="tree-scroll">
                                @if (FilteredRootEstructuras.Any())
                                {
                                    <MudTreeView T="EstructuraOrganizacionalDto" Dense="true" Hover="true">
                                        @foreach (var estructura in FilteredRootEstructuras)
                                        {
                                            @RenderTreeItem(estructura)
                                        }
                                    </MudTreeView>
                                }
                                else
                                {
                                    <MudPaper Class="empty-state pa-8 ma-4" Elevation="0">
                                        <MudIcon Icon="@Icons.Material.Filled.SearchOff"
                                                 Size="Size.Large"
                                                 Color="Color.Default"
                                                 Class="mb-3" />
                                        <MudText Typo="Typo.h6" Class="mud-text-secondary mb-2">
                                            No se encontraron estructuras
                                        </MudText>
                                        <MudText Typo="Typo.body2" Class="mud-text-secondary text-center">
                                            Ajuste el texto de busqueda para ver resultados
                                        </MudText>
                                    </MudPaper>
                                }
                            </div>
                        }
                        else
                        {
                            <MudPaper Class="empty-state pa-8 ma-4" Elevation="0">
                                <MudIcon Icon="@Icons.Material.Filled.AccountTree"
                                         Size="Size.Large"
                                         Color="Color.Default"
                                         Class="mb-3" />
                                <MudText Typo="Typo.h6" Class="mud-text-secondary mb-2">
                                    No hay estructuras organizacionales registradas
                                </MudText>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary text-center">
                                    Comience agregando una nueva estructura organizacional al sistema
                                </MudText>
                            </MudPaper>
                        }
                    </MudCardContent>

                    <MudCardActions Class="tree-actions">
                        <MudButton Variant="Variant.Outlined"
                                   StartIcon="@Icons.Material.Filled.Refresh"
                                   Disabled="@ViewModel.IsLoadingTree"
                                   OnClick="ViewModel.LoadEstructurasAsync">
                            Recargar
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="ViewModel.StartNewRoot">
                            Nueva raiz
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Secondary"
                                   StartIcon="@Icons.Material.Filled.AccountTree"
                                   Disabled="@(ViewModel.SelectedEstructura is null)"
                                   OnClick="ViewModel.StartNewChild">
                            Crear hijo
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudCard Class="estructura-card">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">@ViewModel.FormTitle</MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                Complete el formulario con los datos de la estructura organizacional
                            </MudText>
                        </CardHeaderContent>
                    </MudCardHeader>

                    <MudCardContent>
                        <MudGrid Spacing="2">
                            @* <MudItem xs="12" Style="display: none;">
                                <MudTextField T="string"
                                              Label="Denominacion ID"
                                              Value="@ViewModel.DenominacionLabel"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              ReadOnly="true"
                                              HelperText="Se obtiene automaticamente del sistema" />
                            </MudItem> *@

                            <MudItem xs="12">
                                <MudTextField T="string"
                                              Label="Descripcion *"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Lines="4"
                                              Required="true"
                                              Immediate="true"
                                              OnBlur="@(() => ViewModel.TouchFormField(ConfigEstructuraOrganizacionalViewModel.EstructuraFormField.Descripcion))"
                                              Error="@HasError(ViewModel.GetFormFieldError(ConfigEstructuraOrganizacionalViewModel.EstructuraFormField.Descripcion))"
                                              ErrorText="@ViewModel.GetFormFieldError(ConfigEstructuraOrganizacionalViewModel.EstructuraFormField.Descripcion)"
                                              @bind-Value="ViewModel.EstructuraForm.Descripcion" />
                            </MudItem>

                            <MudItem xs="12">
                                <MudTextField T="string"
                                              Label="Responsable (Pastor) *"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Required="true"
                                              Immediate="true"
                                              HelperText="Ingrese el nombre del responsable"
                                              OnBlur="@(() => ViewModel.TouchFormField(ConfigEstructuraOrganizacionalViewModel.EstructuraFormField.Responsable))"
                                              Error="@HasError(ViewModel.GetFormFieldError(ConfigEstructuraOrganizacionalViewModel.EstructuraFormField.Responsable))"
                                              ErrorText="@ViewModel.GetFormFieldError(ConfigEstructuraOrganizacionalViewModel.EstructuraFormField.Responsable)"
                                              @bind-Value="ViewModel.EstructuraForm.Responsable" />
                            </MudItem>

                            <MudItem xs="12">
                                <MudAutocomplete T="EstructuraOrganizacionalDto"
                                                 Label="Estructura Padre"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense"
                                                 Clearable="true"
                                                 HelperText="Seleccione una estructura padre desde el arbol o busquela aqui (opcional)"
                                                 ToStringFunc="@(estructura => estructura is null ? string.Empty : estructura.Descripcion)"
                                                 SearchFunc="ViewModel.SearchParentAsync"
                                                 Value="@ViewModel.SelectedPadre"
                                                 ValueChanged="OnParentChanged"
                                                 OnBlur="@(() => ViewModel.TouchFormField(ConfigEstructuraOrganizacionalViewModel.EstructuraFormField.Padre))"
                                                 Error="@HasError(ViewModel.GetFormFieldError(ConfigEstructuraOrganizacionalViewModel.EstructuraFormField.Padre))"
                                                 ErrorText="@ViewModel.GetFormFieldError(ConfigEstructuraOrganizacionalViewModel.EstructuraFormField.Padre)" />
                            </MudItem>

                            @* <MudItem xs="12" sm="6">
                                <MudNumericField T="int"
                                                 Label="Orden"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense"
                                                 Min="1"
                                                 @bind-Value="ViewModel.EstructuraForm.Orden" />
                            </MudItem> *@

                            <MudItem xs="12" sm="6">
                                <MudSwitch T="bool"
                                           Label="Activa"
                                           Color="Color.Primary"
                                           @bind-Value="ViewModel.EstructuraForm.Estado" />
                            </MudItem>
                        </MudGrid>

                        <div class="form-actions mt-4">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Save"
                                       Disabled="@(!ViewModel.CanSave)"
                                       OnClick="ViewModel.SaveAsync">
                                @ViewModel.SaveButtonText
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       Disabled="@ViewModel.IsSaving"
                                       OnClick="ViewModel.StartNewRoot">
                                Nuevo
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Error"
                                       StartIcon="@Icons.Material.Filled.Delete"
                                       Disabled="@(!ViewModel.CanDeleteSelected)"
                                       OnClick="ViewModel.DeleteSelectedAsync">
                                Eliminar
                            </MudButton>
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    </MudPaper>
</section>

<style>
    .estructura-shell {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .estructura-header,
    .tree-actions,
    .form-actions {
        display: flex;
        align-items: center;
        gap: .75rem;
    }

    .estructura-header {
        justify-content: space-between;
    }

    .estructura-title {
        font-weight: 700;
    }

    .estructura-container,
    .estructura-card {
        border: 1px solid var(--mud-palette-divider);
        border-radius: var(--mud-default-borderradius);
    }

    .estructura-card {
        height: 100%;
    }

    .tree-loading,
    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 18rem;
        text-align: center;
    }

    .empty-state {
        background-color: var(--mud-palette-action-disabled-background);
        border-radius: 8px;
    }

    .tree-scroll {
        max-height: 600px;
        overflow-y: auto;
        padding: .5rem 1rem 1rem;
    }

    .tree-node-label {
        min-width: 0;
    }

    .tree-node-meta {
        display: flex;
        align-items: center;
        gap: .5rem;
        flex-wrap: wrap;
        margin-top: .15rem;
    }

    .tree-actions,
    .form-actions {
        flex-wrap: wrap;
    }

    @@media (max-width: 600px) {
        .tree-actions,
        .form-actions {
            align-items: stretch;
            flex-direction: column;
        }
    }
</style>

@code {
    private const int RootParentKey = 0;

    private string? _treeSearchText;
    private IReadOnlyList<EstructuraOrganizacionalDto>? _indexedEstructuras;
    private Dictionary<int, IReadOnlyList<EstructuraOrganizacionalDto>> _childrenByParent = [];

    private string TreeSearchTerm => _treeSearchText?.Trim() ?? string.Empty;

    private bool IsTreeSearchActive => !string.IsNullOrWhiteSpace(TreeSearchTerm);

    private IReadOnlyList<EstructuraOrganizacionalDto> FilteredRootEstructuras => GetTreeRootEstructuras()
        .Where(ShouldShowInTree)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await ViewModel.InitializeAsync();
    }

    private RenderFragment RenderTreeItem(EstructuraOrganizacionalDto estructura) => RenderTreeItem(estructura, 0, false);

    /// <summary>
    /// Renderiza recursivamente un item del arbol y sus hijos.
    /// </summary>
    private RenderFragment RenderTreeItem(EstructuraOrganizacionalDto estructura, int nivel, bool ancestorMatchesSearch) => builder =>
    {
        var isSelected = ViewModel.IsSelected(estructura);
        var paddingLeft = nivel * 20;
        var searchActive = IsTreeSearchActive;
        var matchesSearch = TreeNodeMatchesSearch(estructura);
        var shouldShowDescendants = searchActive && (ancestorMatchesSearch || matchesSearch);
        var children = GetVisibleChildren(estructura, shouldShowDescendants);
        var hasChildren = GetTreeChildren(estructura).Any();
        var isExpanded = ViewModel.IsExpanded(estructura);
        var shouldRenderChildren = hasChildren && children.Any() && (isExpanded || searchActive);
        var isNew = !ViewModel.IsEditing;

        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "style",
            $"border-left: 4px solid {(isSelected ? "var(--mud-palette-primary)" : "transparent")}; " +
            $"background-color: {(isSelected ? "var(--mud-palette-action-disabled-background)" : "transparent")}; " +
            $"transition: all 0.2s ease-in-out; padding-left: {paddingLeft}px;");

        builder.OpenElement(2, "div");
        builder.AddAttribute(3, "class", "d-flex align-center pa-2");

        if (hasChildren)
        {
            builder.OpenElement(4, "span");
            builder.AddAttribute(5, "style", "cursor: pointer; display: inline-flex; align-items: center; width: 24px;");
            builder.AddAttribute(6, "onclick", EventCallback.Factory.Create<MouseEventArgs>(this, () => ViewModel.SetExpanded(estructura, !isExpanded)));
            builder.AddEventStopPropagationAttribute(7, "onclick", true);

            builder.OpenComponent<MudIcon>(8);
            builder.AddAttribute(9, "Icon", isExpanded
                ? Icons.Material.Filled.ExpandMore
                : Icons.Material.Filled.ChevronRight);
            builder.AddAttribute(10, "Size", Size.Small);
            builder.AddAttribute(11, "Class", "mr-1");
            builder.CloseComponent();

            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(12, "span");
            builder.AddAttribute(13, "style", "width: 24px; display: inline-block;");
            builder.CloseElement();
        }

        builder.OpenElement(14, "div");
        builder.AddAttribute(15, "class", "d-flex align-center flex-grow-1");

        if (isNew)
        {
            builder.AddAttribute(16, "style", "cursor: pointer; opacity: 0.7;");
            builder.AddAttribute(17, "title", "Click para establecer como padre de la nueva estructura");
            builder.AddAttribute(18, "onclick", EventCallback.Factory.Create<MouseEventArgs>(this, () => ViewModel.SetParent(estructura)));
        }
        else
        {
            builder.AddAttribute(16, "style", "cursor: default;");
        }

        builder.OpenComponent<MudIcon>(19);
        builder.AddAttribute(20, "Icon", Icons.Material.Filled.AccountTree);
        builder.AddAttribute(21, "Color", isSelected ? Color.Primary : Color.Secondary);
        builder.AddAttribute(22, "Size", Size.Medium);
        builder.AddAttribute(23, "Class", "mr-3");
        builder.CloseComponent();

        builder.OpenElement(24, "div");
        builder.AddAttribute(25, "class", "flex-grow-1");

        builder.OpenComponent<MudText>(26);
        builder.AddAttribute(27, "Typo", Typo.body1);
        builder.AddAttribute(28, "Class", "mud-typography-fontWeightMedium");
        builder.AddAttribute(29, "ChildContent", (RenderFragment)(cb =>
        {
            cb.AddContent(30, GetEstructuraTitulo(estructura));
        }));
        builder.CloseComponent();

        var subtitulos = GetEstructuraSubtitulos(estructura);

        foreach (var linea in subtitulos)
        {
            builder.OpenComponent<MudText>(31);
            builder.AddAttribute(32, "Typo", Typo.body2);
            builder.AddAttribute(33, "Class", "mud-text-secondary");
            builder.AddAttribute(34, "ChildContent", (RenderFragment)(cb =>
            {
                cb.AddContent(35, linea);
            }));
            builder.CloseComponent();
        }

        builder.CloseElement();

        builder.OpenComponent<MudIconButton>(47);
        builder.AddAttribute(48, "Icon", Icons.Material.Filled.Edit);
        builder.AddAttribute(49, "Color", Color.Primary);
        builder.AddAttribute(50, "Size", Size.Small);
        builder.AddAttribute(51, "Class", "ml-2");
        builder.AddAttribute(52, "title", "Editar estructura organizacional");
        builder.AddAttribute(53, "OnClick", EventCallback.Factory.Create<MouseEventArgs>(this, () => ViewModel.SelectEstructura(estructura)));
        builder.AddEventStopPropagationAttribute(54, "onclick", true);
        builder.CloseComponent();

        if (estructura.Estado)
        {
            builder.OpenComponent<MudChip<string>>(55);
            builder.AddAttribute(56, "Color", Color.Success);
            builder.AddAttribute(57, "Variant", Variant.Outlined);
            builder.AddAttribute(58, "Size", Size.Small);
            builder.AddAttribute(59, "Class", "ml-2");
            builder.AddAttribute(60, "Text", "Activo");
            builder.CloseComponent();
        }
        else
        {
            builder.OpenComponent<MudChip<string>>(61);
            builder.AddAttribute(62, "Color", Color.Default);
            builder.AddAttribute(63, "Variant", Variant.Outlined);
            builder.AddAttribute(64, "Size", Size.Small);
            builder.AddAttribute(65, "Class", "ml-2");
            builder.AddAttribute(66, "Text", "Inactivo");
            builder.CloseComponent();
        }

        builder.CloseElement();
        builder.CloseElement();
        builder.CloseElement();

        if (shouldRenderChildren)
        {
            builder.OpenElement(67, "div");
            builder.AddAttribute(68, "style", "margin-left: 10px;");

            foreach (var child in children)
            {
                builder.AddContent(69, RenderTreeItem(child, nivel + 1, shouldShowDescendants));
            }

            builder.CloseElement();
        }

        static string GetEstructuraTitulo(EstructuraOrganizacionalDto item)
        {
            return item.Descripcion;
        }

        static IEnumerable<string> GetEstructuraSubtitulos(EstructuraOrganizacionalDto item)
        {
            if (!string.IsNullOrWhiteSpace(item.Responsable))
                yield return $"Responsable: {item.Responsable}";
        }
    };

    private bool ShouldShowInTree(EstructuraOrganizacionalDto estructura)
    {
        return !IsTreeSearchActive || TreeNodeMatchesSearch(estructura) || HasMatchingDescendant(estructura);
    }

    private IReadOnlyList<EstructuraOrganizacionalDto> GetVisibleChildren(
        EstructuraOrganizacionalDto estructura,
        bool ancestorOrSelfMatchesSearch)
    {
        var children = GetTreeChildren(estructura);

        if (!IsTreeSearchActive || ancestorOrSelfMatchesSearch)
            return children;

        return children
            .Where(ShouldShowInTree)
            .ToList();
    }

    private bool HasMatchingDescendant(EstructuraOrganizacionalDto estructura)
    {
        return GetTreeChildren(estructura)
            .Any(child => TreeNodeMatchesSearch(child) || HasMatchingDescendant(child));
    }

    private bool TreeNodeMatchesSearch(EstructuraOrganizacionalDto estructura)
    {
        if (!IsTreeSearchActive)
            return true;

        var term = TreeSearchTerm;

        return ContainsSearchTerm(estructura.Descripcion, term)
            || ContainsSearchTerm(estructura.Responsable, term);
    }

    private static bool ContainsSearchTerm(string? value, string term)
    {
        return !string.IsNullOrWhiteSpace(value)
            && value.Contains(term, StringComparison.OrdinalIgnoreCase);
    }

    private IReadOnlyList<EstructuraOrganizacionalDto> GetTreeRootEstructuras()
    {
        EnsureTreeIndex();

        return _childrenByParent.TryGetValue(RootParentKey, out var roots)
            ? roots
            : [];
    }

    private IReadOnlyList<EstructuraOrganizacionalDto> GetTreeChildren(EstructuraOrganizacionalDto estructura)
    {
        EnsureTreeIndex();

        return _childrenByParent.TryGetValue(estructura.EstructuraOrganizacionalId, out var children)
            ? children
            : [];
    }

    private void EnsureTreeIndex()
    {
        if (ReferenceEquals(_indexedEstructuras, ViewModel.Estructuras))
            return;

        _indexedEstructuras = ViewModel.Estructuras;
        _childrenByParent = ViewModel.Estructuras
            .GroupBy(estructura => estructura.GrupoEstructuraOrganizacionalId ?? RootParentKey)
            .ToDictionary(
                group => group.Key,
                group => (IReadOnlyList<EstructuraOrganizacionalDto>)group
                    .OrderBy(estructura => estructura.Orden)
                    .ThenBy(estructura => estructura.Descripcion)
                    .ToList());
    }

    private void OnParentChanged(EstructuraOrganizacionalDto? estructura)
    {
        ViewModel.SetParent(estructura);
    }

    private static bool HasError(string? error)
    {
        return !string.IsNullOrWhiteSpace(error);
    }
}
