@page "/login"
@layout Layout.AuthLayout
@inject LoginViewModel ViewModel
@inject IDialogService DialogService

<PageTitle>Login - ROCA.Emuna360</PageTitle>

<MudCard Elevation="4" Class="pa-8 mt-4" Style="border-top: 6px solid var(--mud-palette-secondary);">
    <MudCardHeader>
        <CardHeaderContent>
            <div class="d-flex flex-column align-center mb-4">
                <MudImage Src="image/logo.png" Alt="ROCA Logo" Height="100" Class="mb-4" />
                <MudText Typo="Typo.h4" Align="Align.Center" Color="Color.Primary" Style="font-weight: 700;">ROCA.Emuna360</MudText>
                <MudText Typo="Typo.subtitle1" Align="Align.Center" Color="Color.Secondary">Gestión Institucional Integral</MudText>
            </div>
        </CardHeaderContent>
    </MudCardHeader>

    <MudCardContent>
        <MudForm @ref="_form" @bind-IsValid="@_success">
            <MudTextField T="string"
                          Label="Correo electrónico o documento"
                          Required="true"
                          RequiredError="El usuario es requerido."
                          @bind-Value="ViewModel.LoginRequest.Login"
                          Immediate="true"
                          Variant="Variant.Outlined"
                          Margin="Margin.Normal"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Person"
                          Placeholder="usuario@dominio.com" />

            <MudTextField T="string"
                          Label="Contraseña"
                          Required="true"
                          RequiredError="La contraseña es requerida."
                          @bind-Value="ViewModel.LoginRequest.Password"
                          Immediate="true"
                          Variant="Variant.Outlined"
                          Margin="Margin.Normal"
                          InputType="@ViewModel.PasswordInput"
                          Adornment="Adornment.End"
                          AdornmentIcon="@ViewModel.PasswordInputIcon"
                          OnAdornmentClick="@ViewModel.TogglePasswordVisibility"
                          HelperText="Entre 7 y 25 caracteres"
                          Validation="@(new Func<string, string?>(ViewModel.ValidatePassword))" />

            <div class="d-flex align-center justify-space-between mt-2">
                <MudCheckBox T="bool" @bind-Value="ViewModel.LoginRequest.RememberMe" Label="Recordarme" Color="Color.Primary" />
                <MudLink href="forgot-password" Underline="Underline.None">¿Olvidó su contraseña?</MudLink>
            </div>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       Class="mt-6 py-3"
                       Disabled="@(ViewModel.IsLoading || !ViewModel.CanSubmit)"
                       OnClick="HandleLogin">
                @if (ViewModel.IsLoading)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <MudText Class="ms-2">Iniciando sesión...</MudText>
                }
                else
                {
                    <MudText>INICIAR SESIÓN</MudText>
                }
            </MudButton>
        </MudForm>
    </MudCardContent>

    <MudCardActions Class="d-flex justify-center mt-4">
        <MudText Typo="Typo.body2">&iquest;No tiene una cuenta? <MudLink Underline="Underline.None" OnClick="OpenRegistroDialogAsync">Registrarse aqui</MudLink></MudText>
    </MudCardActions>
</MudCard>

<MudText Typo="Typo.caption" Align="Align.Center" Class="d-block mt-8 mud-text-secondary">
    &copy; @DateTime.Now.Year ROCA.Emuna360 - Todos los derechos reservados.
</MudText>

@code {
    private MudForm _form = null!;
    private bool _success;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await ViewModel.RedirectIfSessionActiveAsync();
    }

    private async Task HandleLogin()
    {
        await _form.Validate();
        if (!_form.IsValid)
            return;

        await ViewModel.LoginAsync();
    }
    private async Task OpenRegistroDialogAsync()
    {
        var options = new DialogOptions
        {
            CloseButton = true,
            FullWidth = true,
            MaxWidth = MaxWidth.Medium
        };

        await DialogService.ShowAsync<RegistroDialog>("Registro de cuenta", options);
    }
}
