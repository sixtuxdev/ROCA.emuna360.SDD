@using ROCA.Emuna360.Presentation.WebUI.ViewModels.Organization

<div class="iglesia-form-shell">
    <div class="panel-toolbar">
        <div>
            <MudText Typo="Typo.h6" Color="Color.Primary">@ViewModel.FormTitle</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Datos generales y ubicación</MudText>
        </div>
        @if (ViewModel.IsLoadingGeography)
        {
            <MudProgressCircular Size="Size.Small" Color="Color.Secondary" Indeterminate="true" />
        }
    </div>

    <MudGrid Spacing="2" Class="mt-2">
        <MudItem xs="12">
            <MudTextField T="string"
                          Label="Nombre Iglesia"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Required="true"
                          OnBlur="@(() => ViewModel.TouchIglesiaFormField(ConfigIglesiasViewModel.IglesiaFormField.Nombre))"
                          Error="@HasError(ViewModel.GetIglesiaFormFieldError(ConfigIglesiasViewModel.IglesiaFormField.Nombre))"
                          ErrorText="@ViewModel.GetIglesiaFormFieldError(ConfigIglesiasViewModel.IglesiaFormField.Nombre)"
                          @bind-Value="ViewModel.IglesiaForm.Nombre" />
        </MudItem>

        <MudItem xs="12" sm="6">
            <MudTextField T="string"
                          Label="Slug"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Required="true"
                          ReadOnly="true"
                          OnBlur="@(() => ViewModel.TouchIglesiaFormField(ConfigIglesiasViewModel.IglesiaFormField.Slug))"
                          Error="@HasError(ViewModel.GetIglesiaFormFieldError(ConfigIglesiasViewModel.IglesiaFormField.Slug))"
                          ErrorText="@ViewModel.GetIglesiaFormFieldError(ConfigIglesiasViewModel.IglesiaFormField.Slug)"
                          @bind-Value="ViewModel.IglesiaForm.Slug" />
        </MudItem>

        <MudItem xs="12" sm="6">
            <MudTextField T="string"
                          Label="Personería Jurídica"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Required="true"
                          ReadOnly="true"
                          OnBlur="@(() => ViewModel.TouchIglesiaFormField(ConfigIglesiasViewModel.IglesiaFormField.PersoneriaJuridica))"
                          Error="@HasError(ViewModel.GetIglesiaFormFieldError(ConfigIglesiasViewModel.IglesiaFormField.PersoneriaJuridica))"
                          ErrorText="@ViewModel.GetIglesiaFormFieldError(ConfigIglesiasViewModel.IglesiaFormField.PersoneriaJuridica)"
                          @bind-Value="ViewModel.IglesiaForm.PersoneriaJuridica" />
        </MudItem>

        <MudItem xs="12" sm="6">
            <MudSelect T="int?"
                       Label="País"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Required="true"
                       Clearable="true"
                       Value="@ViewModel.IglesiaForm.PaisId"
                       ValueChanged="@OnPaisChanged"
                       ToStringFunc="@GetPaisText">
                @foreach (var pais in ViewModel.Paises)
                {
                    <MudSelectItem T="int?" Value="@((int?)pais.PaisId)">@pais.PaisNombre</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12" sm="6">
            <MudSelect T="int?"
                       Label="Departamento"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Required="true"
                       Clearable="true"
                       Disabled="@(!ViewModel.IglesiaForm.PaisId.HasValue)"
                       Value="@ViewModel.IglesiaForm.DepartamentoId"
                       ValueChanged="@OnDepartamentoChanged"
                       ToStringFunc="@GetDepartamentoText">
                @foreach (var departamento in ViewModel.Departamentos)
                {
                    <MudSelectItem T="int?" Value="@((int?)departamento.DepartamentoId)">@departamento.DepartamentoNombre</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12" sm="6">
            <MudSelect T="int?"
                       Label="Ciudad"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Required="true"
                       Clearable="true"
                       Disabled="@(!ViewModel.IglesiaForm.DepartamentoId.HasValue)"
                       Value="@ViewModel.IglesiaForm.CiudadId"
                       ValueChanged="@OnCiudadChanged"
                       ToStringFunc="@GetCiudadText">
                @foreach (var ciudad in ViewModel.Ciudades)
                {
                    <MudSelectItem T="int?" Value="@((int?)ciudad.CiudadId)">@ciudad.CiudadNombre</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12" sm="6">
            <MudSelect T="int?"
                       Label="Corregimiento"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true"
                       Disabled="@(!ViewModel.IglesiaForm.CiudadId.HasValue)"
                       Value="@ViewModel.IglesiaForm.CorregimientoId"
                       ValueChanged="@OnCorregimientoChanged"
                       ToStringFunc="@GetCorregimientoText">
                @foreach (var corregimiento in ViewModel.Corregimientos)
                {
                    <MudSelectItem T="int?" Value="@((int?)corregimiento.CorregimientoId)">@corregimiento.CorregimientoNombre</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12">
            <MudTextField T="string"
                          Label="Dirección"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          @bind-Value="ViewModel.IglesiaForm.Direccion" />
        </MudItem>

        <MudItem xs="12" sm="6">
            <MudTextField T="string"
                          Label="Teléfono"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          @bind-Value="ViewModel.IglesiaForm.Telefono" />
        </MudItem>

        <MudItem xs="12" sm="6">
            <MudTextField T="string"
                          Label="Correo"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Error="@HasError(ViewModel.ValidateCorreo(ViewModel.IglesiaForm.Correo))"
                          ErrorText="@ViewModel.ValidateCorreo(ViewModel.IglesiaForm.Correo)"
                          @bind-Value="ViewModel.IglesiaForm.Correo" />
        </MudItem>

        <MudItem xs="12">
            <MudTextField T="string"
                          Label="Slogan"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Lines="2"
                          Immediate="true"
                          ReadOnly="true"
                          @bind-Value="ViewModel.IglesiaForm.Slogan" />
        </MudItem>

        <MudItem xs="12" sm="4">
            <MudSwitch T="bool"
                       Label="Iglesia activa"
                       Color="Color.Primary"
                       @bind-Value="ViewModel.IglesiaForm.Activa" />
        </MudItem>

        <MudItem xs="12" sm="8">
            <div class="estructura-selector pastor-selector @(ViewModel.IglesiaForm.PastorResponsableRegistroId is > 0 ? string.Empty : "selector-required")">
                <div class="estructura-selector-content">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Pastor Responsable *</MudText>
                    @if (ViewModel.IglesiaForm.PastorResponsableRegistroId is not > 0)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Sin pastor seleccionado</MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.body1" Class="mud-typography-fontWeightMedium">
                            @ViewModel.PastorResponsableNombre
                        </MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            UsuarioId: @ViewModel.IglesiaForm.PastorResponsableRegistroId
                        </MudText>
                    }
                </div>
                <div class="estructura-selector-actions">
                    <MudIconButton Icon="@Icons.Material.Filled.SupervisorAccount"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   title="Seleccionar pastor responsable"
                                   OnClick="ViewModel.OpenPastorResponsableSelectorAsync" />
                </div>
            </div>
        </MudItem>

        <MudItem xs="12">
            <div class="estructura-selector">
                <div class="estructura-selector-content">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Estructura organizacional</MudText>
                    @if (ViewModel.IglesiaForm.EstructuraOrg is null)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Sin estructura seleccionada</MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.body1" Class="mud-typography-fontWeightMedium">
                            @ViewModel.IglesiaForm.EstructuraOrg.Descripcion
                        </MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            Responsable: @(string.IsNullOrWhiteSpace(ViewModel.IglesiaForm.EstructuraOrg.Responsable) ? "Sin responsable" : ViewModel.IglesiaForm.EstructuraOrg.Responsable)
                        </MudText>
                    }
                </div>
                <div class="estructura-selector-actions">
                    @if (ViewModel.IglesiaForm.EstructuraOrg is not null)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Clear"
                                       Color="Color.Default"
                                       Size="Size.Small"
                                       title="Limpiar estructura"
                                       OnClick="ViewModel.ClearEstructura" />
                    }
                    <MudIconButton Icon="@Icons.Material.Filled.AccountTree"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   title="Seleccionar estructura"
                                   OnClick="ViewModel.OpenEstructuraSelectorAsync" />
                </div>
            </div>
        </MudItem>
    </MudGrid>

    <div class="form-actions">
        @if (ShowClearButton)
        {
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.CleaningServices"
                       OnClick="ViewModel.StartNewIglesia">
                Limpiar
            </MudButton>
        }
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save"
                   Disabled="@(!ViewModel.CanSaveIglesia)"
                   OnClick="SaveIglesiaAsync">
            @ViewModel.SaveButtonText
        </MudButton>
    </div>
</div>

<style>
    .iglesia-form-shell {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .panel-toolbar,
    .form-actions {
        display: flex;
        align-items: center;
        gap: .75rem;
        justify-content: space-between;
    }

    .form-actions {
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .estructura-selector {
        align-items: center;
        border: 1px solid var(--mud-palette-lines-inputs);
        border-radius: var(--mud-default-borderradius);
        display: flex;
        gap: .75rem;
        justify-content: space-between;
        min-height: 56px;
        padding: .55rem .75rem;
    }

    .estructura-selector-content {
        min-width: 0;
    }

    .estructura-selector-actions {
        align-items: center;
        display: flex;
        flex: 0 0 auto;
        gap: .25rem;
    }

    .pastor-selector.selector-required {
        border-color: var(--mud-palette-warning);
    }

    @@media (max-width: 600px) {
        .panel-toolbar,
        .form-actions,
        .estructura-selector {
            align-items: stretch;
            flex-direction: column;
        }

        .estructura-selector-actions {
            justify-content: flex-end;
        }
    }
</style>

@code {
    [Parameter, EditorRequired]
    public ConfigIglesiasViewModel ViewModel { get; set; } = default!;

    [Parameter]
    public bool ShowClearButton { get; set; } = true;

    [Parameter]
    public EventCallback OnSaved { get; set; }

    private static bool HasError(string? value)
    {
        return !string.IsNullOrWhiteSpace(value);
    }

    private string GetPaisText(int? value)
    {
        if (!value.HasValue)
            return string.Empty;

        return ViewModel.Paises
            .FirstOrDefault(pais => pais.PaisId == value.Value)
            ?.PaisNombre ?? string.Empty;
    }

    private string GetDepartamentoText(int? value)
    {
        if (!value.HasValue)
            return string.Empty;

        return ViewModel.Departamentos
            .FirstOrDefault(departamento => departamento.DepartamentoId == value.Value)
            ?.DepartamentoNombre ?? string.Empty;
    }

    private string GetCiudadText(int? value)
    {
        if (!value.HasValue)
            return string.Empty;

        return ViewModel.Ciudades
            .FirstOrDefault(ciudad => ciudad.CiudadId == value.Value)
            ?.CiudadNombre ?? string.Empty;
    }

    private string GetCorregimientoText(int? value)
    {
        if (!value.HasValue)
            return string.Empty;

        return ViewModel.Corregimientos
            .FirstOrDefault(corregimiento => corregimiento.CorregimientoId == value.Value)
            ?.CorregimientoNombre ?? string.Empty;
    }

    private async Task OnPaisChanged(int? value)
    {
        await ViewModel.ChangePaisAsync(value);
    }

    private async Task OnDepartamentoChanged(int? value)
    {
        await ViewModel.ChangeDepartamentoAsync(value);
    }

    private async Task OnCiudadChanged(int? value)
    {
        await ViewModel.ChangeCiudadAsync(value);
    }

    private void OnCorregimientoChanged(int? value)
    {
        ViewModel.ChangeCorregimiento(value);
    }

    private async Task SaveIglesiaAsync()
    {
        await ViewModel.SaveIglesiaAsync();

        if (ViewModel.LastSaveSucceeded)
        {
            await OnSaved.InvokeAsync();
        }
    }
}
