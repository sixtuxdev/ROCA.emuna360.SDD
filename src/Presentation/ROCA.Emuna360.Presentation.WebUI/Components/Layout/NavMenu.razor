@inject TokenStorageService TokenStorage

<MudNavMenu Class="mud-width-full roca-nav-menu" Color="Color.Primary">
    <MudText Typo="Typo.h6" Class="px-4 pt-4 roca-nav-title">
        Emuna360
    </MudText>

    <MudText Typo="Typo.body2" Class="px-4 mud-text-secondary">
        Sistema de Gestión
    </MudText>

    <MudDivider Class="my-2" />

    <MudNavLink Href="/dashboard"
                Icon="@Icons.Material.Filled.Dashboard"
                IconColor="Color.Secondary"
                Match="NavLinkMatch.All"
                Class="roca-nav-link">
        Dashboard
    </MudNavLink>

    @if (_isLoading)
    {
        <MudText Typo="Typo.body2"
                 Class="px-4 py-2 mud-text-secondary">
            Cargando menús...
        </MudText>
    }
    else if (_menus.Any())
    {
        @foreach (var grupo in _menus.Where(m => NormalizarTipo(m.Tipo) == "G"))
        {
            var hijos = _menus.Where(m =>
                NormalizarTipo(m.Tipo) == "S" &&
                m.IdGrupo.HasValue &&
                m.IdGrupo.Value == grupo.MenuId).ToList();

            @if (hijos.Any())
            {
                <MudNavGroup Title="@grupo.Descripcion"
                             Icon="@GetIcon(grupo.Imagen)"
                             IconColor="Color.Secondary"
                             Expanded="_expandedGroups.TryGetValue(grupo.MenuId, out var expanded) && expanded"
                             Class="roca-nav-group">
                    @foreach (var subMenu in hijos)
                    {
                        <MudNavLink Href="@NormalizeUrl(subMenu.Url)"
                                    Icon="@GetIcon(subMenu.Imagen)"
                                    IconColor="Color.Secondary"
                                    Match="NavLinkMatch.Prefix"
                                    Class="roca-nav-link">
                            @subMenu.Descripcion
                        </MudNavLink>
                    }
                </MudNavGroup>
            }
            else
            {
                <MudNavLink Href="@NormalizeUrl(grupo.Url)"
                            Icon="@GetIcon(grupo.Imagen)"
                            IconColor="Color.Secondary"
                            Match="NavLinkMatch.Prefix"
                            Class="roca-nav-link">
                    @grupo.Descripcion
                </MudNavLink>
            }
        }
    }
    else if (!_isLoading)
    {
        <MudText Typo="Typo.body2"
                 Class="px-4 py-2 mud-text-secondary">
            No hay menús disponibles
        </MudText>
    }
</MudNavMenu>

<style>
    .roca-nav-menu {
        background-color: var(--mud-palette-primary);
        color: var(--mud-palette-surface);
        height: 100%;
    }

    .roca-nav-menu .mud-divider {
        border-color: color-mix(in srgb, var(--mud-palette-surface) 24%, transparent);
    }

    .roca-nav-title,
    .roca-nav-menu .mud-typography,
    .roca-nav-menu .mud-text-secondary {
        color: var(--mud-palette-surface) !important;
    }

    .roca-nav-link,
    .roca-nav-group .mud-nav-link {
        color: var(--mud-palette-surface);
    }

    .roca-nav-link.active,
    .roca-nav-menu .mud-nav-link.active {
        background-color: var(--mud-palette-secondary);
        color: var(--mud-palette-surface);
    }
</style>

@code {
    private List<AuthMenuDto> _menus = new();
    private readonly Dictionary<int, bool> _expandedGroups = new();
    private bool _isLoading = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            _menus = (await TokenStorage.GetMenusAsync())
                .OrderBy(menu => menu.Orden)
                .ToList();

            foreach (var grupo in _menus.Where(menu => NormalizarTipo(menu.Tipo) == "G"))
            {
                _expandedGroups.TryAdd(grupo.MenuId, false);
            }
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private static string NormalizeUrl(string url)
    {
        if (string.IsNullOrWhiteSpace(url))
            return string.Empty;

        return url.TrimStart('/');
    }

    private static string GetIcon(string? iconName)
