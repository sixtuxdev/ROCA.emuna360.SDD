    }

    private static string NormalizarTipo(string? tipo)
    {
        if (string.IsNullOrWhiteSpace(tipo))
            return string.Empty;

        var normalized = tipo.Trim().ToUpperInvariant();

        return normalized switch
        {
            "G" => "G",
            "S" => "S",
            "O" => "S",
            _ => string.Empty
        };
    }
}
