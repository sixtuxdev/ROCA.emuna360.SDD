@inject MenuViewModel ViewModel

<MudNavMenu Class="mud-width-full roca-nav-menu" Color="Color.Primary">
    <MudText Typo="Typo.h6" Class="px-4 pt-4 roca-nav-title">
        Emuna360
    </MudText>

    <MudText Typo="Typo.body2" Class="px-4 mud-text-secondary">
        Sistema de Gestión
    </MudText>

    <MudDivider Class="my-2" />

    <MudNavLink Href="/dashboard"
                Icon="@Icons.Material.Filled.Dashboard"
                IconColor="Color.Tertiary"
                Match="NavLinkMatch.All"
                Class="roca-nav-link">
        Dashboard
    </MudNavLink>

    @if (ViewModel.IsLoading)
    {
        <MudText Typo="Typo.body2"
                 Class="px-4 py-2 mud-text-secondary">
            Cargando menús...
        </MudText>
    }
    else if (ViewModel.Menus.Any())
    {
        @foreach (var grupo in ViewModel.Groups)
        {
            var hijos = ViewModel.GetChildren(grupo);

            @if (hijos.Any())
            {
                <MudNavGroup Title="@grupo.Descripcion"
                             Icon="@MenuViewModel.GetIcon(grupo.Imagen)"
                             IconColor="Color.Tertiary"
                             Expanded="ViewModel.ExpandedGroups.TryGetValue(grupo.MenuId, out var expanded) && expanded"
                             Class="roca-nav-group">
                    @foreach (var subMenu in hijos)
                    {
                        <MudNavLink Href="@MenuViewModel.NormalizeUrl(subMenu.Url)"
                                    Icon="@MenuViewModel.GetIcon(subMenu.Imagen)"
                                    IconColor="Color.Tertiary"
                                    Match="NavLinkMatch.Prefix"
                                    Class="roca-nav-link">
                            @subMenu.Descripcion
                        </MudNavLink>
                    }
                </MudNavGroup>
            }
            else
            {
                <MudNavLink Href="@MenuViewModel.NormalizeUrl(grupo.Url)"
                            Icon="@MenuViewModel.GetIcon(grupo.Imagen)"
                            IconColor="Color.Tertiary"
                            Match="NavLinkMatch.Prefix"
                            Class="roca-nav-link">
                    @grupo.Descripcion
                </MudNavLink>
            }
        }
    }
    else if (!ViewModel.IsLoading)
    {
        <MudText Typo="Typo.body2"
                 Class="px-4 py-2 mud-text-secondary">
            No hay menús disponibles
        </MudText>
    }
</MudNavMenu>

<style>
    .roca-nav-menu {
        background-color: var(--mud-palette-primary);
        color: var(--mud-palette-tertiary);
        height: 100%;
    }

    .roca-nav-menu .mud-divider {
        border-color: color-mix(in srgb, var(--mud-palette-tertiary) 24%, transparent);
    }

    .roca-nav-title,
    .roca-nav-menu .mud-typography,
    .roca-nav-menu .mud-text-secondary {
        color: var(--mud-palette-tertiary) !important;
    }

    .roca-nav-link,
    .roca-nav-group .mud-nav-link {
        color: var(--mud-palette-tertiary);
    }

    .roca-nav-menu .mud-icon-root {
        color: var(--mud-palette-tertiary) !important;
    }

    .roca-nav-menu .mud-nav-link.active,
    .roca-nav-menu .mud-nav-link.active:hover,
    .roca-nav-menu .mud-nav-link[aria-current="page"],
    .roca-nav-menu .mud-nav-link[aria-current="page"]:hover {
        background-color: var(--mud-palette-secondary) !important;
        color: var(--mud-palette-primary) !important;
    }

    .roca-nav-menu .mud-nav-link.active .mud-nav-link-text,
    .roca-nav-menu .mud-nav-link.active .mud-nav-link-icon,
    .roca-nav-menu .mud-nav-link.active .mud-icon-root,
    .roca-nav-menu .mud-nav-link[aria-current="page"] .mud-nav-link-text,
    .roca-nav-menu .mud-nav-link[aria-current="page"] .mud-nav-link-icon,
    .roca-nav-menu .mud-nav-link[aria-current="page"] .mud-icon-root {
            color: var(--mud-palette-primary) !important;
            fill: var(--mud-palette-primary) !important;
    }
</style>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await ViewModel.InitializeAsync();
        StateHasChanged();
    }
}
